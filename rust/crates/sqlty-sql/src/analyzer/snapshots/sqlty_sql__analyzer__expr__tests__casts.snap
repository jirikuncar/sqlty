---
source: crates/sqlty-sql/src/analyzer/expr.rs
expression: "reports(&queries, \"postgres\", Some(DDL))"
---
SELECT i::BIGINT AS a, i::TEXT AS b, txt::INT AS c, n::NUMERIC(10, 2) AS d
a: int | BIGINT | Unknown
b: str | TEXT | Unknown
c: int | INT | Unknown
d: decimal.Decimal | DECIMAL(10, 2) | Unknown

SELECT CAST(i AS DOUBLE PRECISION) AS a, CAST(txt AS VARCHAR(20)) AS b FROM t
a: float | DOUBLE | NonNull
b: str | VARCHAR(20) | Nullable

SELECT '1'::INT AS a, NULL::TEXT AS b, 1::BOOLEAN AS c
a: int | INT | NonNull
b: str | TEXT | Nullable
c: bool | BOOLEAN | NonNull

SELECT i::INT[] AS a, txt::TEXT[] AS b, '{}'::INT[][] AS c
a: list[int] | ARRAY<INT> | Unknown
b: list[str] | ARRAY<TEXT> | Unknown
c: list[list[int]] | ARRAY<ARRAY<INT>> | NonNull

SELECT m::TEXT AS a, txt::mood AS b, i::positive AS c
a: str | TEXT | Unknown
b: typing.Literal['sad', 'ok', 'happy'] | MOOD | Unknown
c: int | INT | Unknown

SELECT i::pair AS a
a: ? | PAIR | Unknown

SELECT i::no_such_type AS a
a: ? | NO_SUCH_TYPE | Unknown
[unknown-type] type `no_such_type` has no Python type

SELECT i::JSONB AS a, i::UUID AS b, i::BYTEA AS c, i::DATE AS d
a: typing.Any | JSONB | Unknown
b: uuid.UUID | UUID | Unknown
c: bytes | VARBINARY | Unknown
d: datetime.date | DATE | Unknown
