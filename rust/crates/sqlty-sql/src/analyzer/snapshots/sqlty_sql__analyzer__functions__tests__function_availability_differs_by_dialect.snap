---
source: crates/sqlty-sql/src/analyzer/functions.rs
expression: "format!(\"mysql:\\n{mysql}\\npostgres:\\n{postgres}\")"
---
mysql:
SELECT ifnull(i, 0) AS a, concat_ws(',', txt, txt) AS b, if(i > 1, 1, 0) AS c FROM t
a: int | INT | NonNull
b: str | TEXT | NonNull
c: typing.Literal[1, 0] | ? | NonNull

SELECT date_format(ts, '%Y') AS a, curdate() AS b, group_concat(txt) AS c FROM t
a: str | TEXT | Nullable
b: datetime.date | DATE | NonNull
c: str | TEXT | Nullable

SELECT avg(i) AS a, sum(i) AS b, round(n, 1) AS c, stddev(i) AS d FROM t
a: decimal.Decimal | DECIMAL | Nullable
b: decimal.Decimal | DECIMAL | Nullable
c: decimal.Decimal | DECIMAL(10, 2) | NonNull
d: float | DOUBLE | Nullable

postgres:
SELECT ifnull(i, 0) AS a, concat_ws(',', txt, txt) AS b, if(i > 1, 1, 0) AS c FROM t
a: ? | ? | Unknown
b: str | TEXT | NonNull
c: ? | ? | NonNull

SELECT date_format(ts, '%Y') AS a, curdate() AS b, group_concat(txt) AS c FROM t
a: ? | ? | Unknown
b: ? | ? | Unknown
c: str | TEXT | Nullable

SELECT avg(i) AS a, sum(i) AS b, round(n, 1) AS c, stddev(i) AS d FROM t
a: ? | ? | Nullable
b: decimal.Decimal | NUMERIC | Nullable
c: decimal.Decimal | DECIMAL | Unknown
d: ? | ? | Nullable
