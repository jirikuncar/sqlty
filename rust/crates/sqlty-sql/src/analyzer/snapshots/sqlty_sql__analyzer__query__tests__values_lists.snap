---
source: crates/sqlty-sql/src/analyzer/query.rs
expression: "format!(\"postgres:\\n{postgres}\\nmysql:\\n{mysql}\\nsqlite:\\n{sqlite}\")"
---
postgres:
VALUES (1, 'a'), (2, 'b')
column1: typing.Literal[1, 2] | ? | NonNull
column2: typing.Literal['a', 'b'] | ? | NonNull

VALUES (1), (2.5)
column1: decimal.Decimal | DECIMAL | NonNull

VALUES (1), (NULL)
column1: typing.Literal[1] | ? | Nullable

VALUES (1), (1, 2)
column1: typing.Literal[1] | ? | NonNull

SELECT * FROM (VALUES (1, 'a')) AS v(n, s)
n: typing.Literal[1] | ? | NonNull
s: typing.Literal['a'] | ? | NonNull

SELECT column1 FROM (VALUES (1)) AS v
column1: typing.Literal[1] | ? | NonNull

VALUES (1) UNION SELECT id FROM a
column1: int | INT | NonNull

mysql:
VALUES ROW(1, 'a'), ROW(2, NULL)
column_0: typing.Literal[1, 2] | ? | NonNull
column_1: typing.Literal['a'] | ? | Nullable

SELECT * FROM (VALUES ROW(1, 'a')) AS v
column_0: typing.Literal[1] | ? | NonNull
column_1: typing.Literal['a'] | ? | NonNull

SELECT column_1 FROM (VALUES ROW(1, 'a')) AS v
column_1: typing.Literal['a'] | ? | NonNull

SELECT a FROM (VALUES ROW(1, 'a')) AS v(a, b)
a: typing.Literal[1] | ? | NonNull

sqlite:
VALUES (1, 'a'), (2, 2.5)
column1: typing.Literal[1, 2] | ? | NonNull
column2: str | float | ? | NonNull

SELECT * FROM (VALUES (1, NULL))
column1: typing.Literal[1] | ? | NonNull
column2: ? | ? | Nullable
