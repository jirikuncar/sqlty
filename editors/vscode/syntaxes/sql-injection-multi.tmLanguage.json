    "triple-double": {
      "contentName": "meta.embedded.sql",
      "begin": "(?<=\"\"\")(?<![fFtT]\"\"\")[ \\t]*(--sql|-- sql(?=[ \\t]*(?:--[^\\\"'\\\\]*)?(?:\\\\[nr]|$)))",
      "beginCaptures": {
        "1": {
          "name": "comment.line.double-dash.sql"
        }
      },
      "end": "(?=\"\"\")",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "name": "comment.line.double-dash.sql",
          "begin": "--",
          "end": "(?=\\\\n|\"\"\")|$"
        },
        {
          "name": "comment.block.sql",
          "begin": "/\\*",
          "end": "\\*/|(?=\"\"\")"
        },
        {
          "name": "string.quoted.single.sql",
          "begin": "'",
          "end": "'|(?=\"\"\")",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "include": "#sql"
        }
      ]
    },
    "leading-blank-double": {
      "begin": "(?<=\"\"\")(?<![fFtT]\"\"\")(?=[ \\t]*$)",
      "end": "(?=\"\"\")",
      "patterns": [
        {
          "include": "#marker-line-double"
        },
        {
          "begin": "^(?=[ \\t]*\\S)",
          "end": "(?=\"\"\")"
        }
      ]
    },
