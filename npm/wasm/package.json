    "webassembly",
    "wasm",
    "postgresql",
    "sqlite",
    "mysql"
  ],
  "homepage": "https://sqlty.kuncar.dev/recipes/embedding/",
  "bugs": "https://github.com/jirikuncar/sqlty/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jirikuncar/sqlty.git",
    "directory": "npm/wasm"
  },
  "license": "MIT",
  "author": "Jiri Kuncar",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./engine": "./engine.js",
    "./sqlty_wasm.wasm": "./sqlty_wasm.wasm",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "engine.js",
    "engine.d.ts",
    "sqlty_wasm.wasm"
  ],
