from typing import Literal, overload
from sqlty import SQL, SQLRegistry

@overload
def sql(query: Literal["SELECT 1::INTEGER"]) -> SQL[tuple[int]]: ...
@overload
def sql(query: str) -> str: ...
@overload
def sql_with_schema(
    query: Literal["SELECT id::INTEGER, name::TEXT FROM users"],
) -> SQL[tuple[int, str]]: ...
@overload
def sql_with_schema(query: str) -> str: ...
