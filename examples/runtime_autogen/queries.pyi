from typing import Literal, overload
from sqlty import SQL

@overload
def comment_sql(query: Literal["SELECT COUNT(*)::INTEGER FROM comments"]) -> SQL[tuple[int]]: ...
@overload
def comment_sql(
    query: Literal["SELECT id::INTEGER, text::TEXT FROM comments WHERE post_id = :post_id"],
) -> SQL[tuple[int, str]]: ...
@overload
def comment_sql(query: str) -> str: ...
@overload
def post_sql(query: Literal["SELECT COUNT(*)::INTEGER FROM posts"]) -> SQL[tuple[int]]: ...
@overload
def post_sql(
    query: Literal["SELECT id::INTEGER, title::TEXT FROM posts WHERE user_id = :user_id"],
) -> SQL[tuple[int, str]]: ...
@overload
def post_sql(
    query: Literal["SELECT id::INTEGER, title::TEXT, body::TEXT FROM posts WHERE id = :id"],
) -> SQL[tuple[int, str, str]]: ...
@overload
def post_sql(query: str) -> str: ...
@overload
def user_sql(query: Literal["SELECT COUNT(*)::INTEGER FROM users"]) -> SQL[tuple[int]]: ...
@overload
def user_sql(
    query: Literal["SELECT id::INTEGER, name::TEXT FROM users"],
) -> SQL[tuple[int, str]]: ...
@overload
def user_sql(
    query: Literal["SELECT id::INTEGER, name::TEXT, email::TEXT FROM users WHERE id = :id"],
) -> SQL[tuple[int, str, str]]: ...
@overload
def user_sql(query: str) -> str: ...
