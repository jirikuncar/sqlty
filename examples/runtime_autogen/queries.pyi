from typing import Literal, overload

@overload
def comment_sql(query: Literal["SELECT COUNT(*)::INTEGER FROM comments"]) -> tuple[int]: ...
@overload
def comment_sql(
    query: Literal["SELECT id::INTEGER, text::TEXT FROM comments WHERE post_id = :post_id"],
) -> tuple[int, str]: ...
@overload
def comment_sql(query: str) -> str: ...
@overload
def post_sql(query: Literal["SELECT COUNT(*)::INTEGER FROM posts"]) -> tuple[int]: ...
@overload
def post_sql(
    query: Literal["SELECT id::INTEGER, title::TEXT FROM posts WHERE user_id = :user_id"],
) -> tuple[int, str]: ...
@overload
def post_sql(
    query: Literal["SELECT id::INTEGER, title::TEXT, body::TEXT FROM posts WHERE id = :id"],
) -> tuple[int, str, str]: ...
@overload
def post_sql(query: str) -> str: ...
@overload
def user_sql(query: Literal["SELECT COUNT(*)::INTEGER FROM users"]) -> tuple[int]: ...
@overload
def user_sql(query: Literal["SELECT id::INTEGER, name::TEXT FROM users"]) -> tuple[int, str]: ...
@overload
def user_sql(
    query: Literal["SELECT id::INTEGER, name::TEXT, email::TEXT FROM users WHERE id = :id"],
) -> tuple[int, str, str]: ...
@overload
def user_sql(query: str) -> str: ...
